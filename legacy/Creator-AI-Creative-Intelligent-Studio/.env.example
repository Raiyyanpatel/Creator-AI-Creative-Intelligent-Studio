# Creator AI Backend Environment Configuration

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=True

# PostgreSQL Database Configuration
DATABASE_URL=postgresql+psycopg2://creator:creator_password@localhost:5432/creator_ai_db

# LLM Providers (OpenAI / Gemini / vLLM / Ollama)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
DEFAULT_LLM_MODEL=gpt-4o-mini
GEMINI_API_KEY=

# Composio Integration (For automated social publishing)
COMPOSIO_API_KEY=
COMPOSIO_ENTITY_ID=default

# Social Platform Keys (Optional for extended API rate limits)
YOUTUBE_API_KEY=
TWITTER_BEARER_TOKEN=
